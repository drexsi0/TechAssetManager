@model GerenciadorAtivos.Models.ViewModels.DashboardViewModel
@inject IUiTextService T

@{
    ViewData["Title"] = T["Dashboard.Title"];

    var labelsSetor = new List<string>();
    var dataSetor = new List<int>();
    var idsSetor = new List<string>();
    var listaSetores = Html.GetEnumSelectList<GerenciadorAtivos.Models.SetorAtivo>();

    foreach (var item in Model.AtivosPorSetor)
    {
        var nome = listaSetores.FirstOrDefault(x => x.Value == item.Key)?.Text ?? item.Key;
        labelsSetor.Add(nome);
        idsSetor.Add(item.Key);
        dataSetor.Add(item.Value);
    }

    var depreciacao = Model.ValorTotalInvestido - Model.ValorTotalAtual;
    var taxaUso = Model.TotalAtivos == 0 ? 0 : Math.Round((decimal)Model.EmUso / Model.TotalAtivos * 100, 1);
    var taxaDisponibilidade = Model.TotalAtivos == 0 ? 0 : Math.Round((decimal)Model.Disponiveis / Model.TotalAtivos * 100, 1);
}

<section class="dashboard-hero">
    <div>
        <h1 class="dashboard-title">@T["Dashboard.Title"]</h1>
        <p class="dashboard-subtitle">@T["Dashboard.Subtitle"]</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Ativos" asp-action="Index" class="btn btn-primary"><i class="bi bi-box-seam me-1"></i>@T["Dashboard.ManageInventory"]</a>
        <a asp-controller="Relatorios" asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-download me-1"></i>@T["Dashboard.ExportReports"]</a>
    </div>
</section>

<section class="dashboard-grid mb-3">
    <article class="app-card kpi-card">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <div class="kpi-label">@T["Dashboard.TotalAssets"]</div>
                <div class="kpi-value">@Model.TotalAtivos</div>
            </div>
            <span class="kpi-icon"><i class="bi bi-hdd-stack"></i></span>
        </div>
        <div class="kpi-note">@T["Dashboard.Registered"]</div>
    </article>

    <article class="app-card kpi-card">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <div class="kpi-label">@T["Dashboard.Available"]</div>
                <div class="kpi-value text-success">@Model.Disponiveis</div>
            </div>
            <span class="kpi-icon"><i class="bi bi-check2-circle"></i></span>
        </div>
        <div class="kpi-note">@T["Dashboard.InStock"] · @taxaDisponibilidade%</div>
    </article>

    <article class="app-card kpi-card">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <div class="kpi-label">@T["Dashboard.InUse"]</div>
                <div class="kpi-value text-primary">@Model.EmUso</div>
            </div>
            <span class="kpi-icon"><i class="bi bi-person-check"></i></span>
        </div>
        <div class="kpi-note">@T["Dashboard.WithUsers"] · @taxaUso%</div>
    </article>

    <article class="app-card kpi-card">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <div class="kpi-label">@T["Dashboard.Maintenance"]</div>
                <div class="kpi-value text-warning">@Model.EmManutencao</div>
            </div>
            <span class="kpi-icon"><i class="bi bi-tools"></i></span>
        </div>
        <div class="kpi-note">@T["Dashboard.RequiresAttention"]</div>
    </article>
</section>

<section class="dashboard-grid">
    <article class="app-card dashboard-panel grid-span-4">
        <div class="panel-header">
            <h2>@T["Dashboard.InventoryHealth"]</h2>
            <span class="badge text-bg-primary">@Model.TotalAtivos @T["Common.Assets"]</span>
        </div>
        <div class="metric-list">
            <div class="metric-row"><span>@T["Dashboard.TotalInvested"]</span><strong>@Model.ValorTotalInvestido.ToString("C")</strong></div>
            <div class="metric-row"><span>@T["Dashboard.CurrentValue"]</span><strong>@Model.ValorTotalAtual.ToString("C")</strong></div>
            <div class="metric-row"><span>@T["Dashboard.Depreciation"]</span><strong class="text-danger">@depreciacao.ToString("C")</strong></div>
        </div>
    </article>

    <article class="app-card dashboard-panel grid-span-4">
        <div class="panel-header"><h2>@T["Dashboard.ByStatus"]</h2></div>
        <div class="chart-box compact"><canvas id="graficoStatus"></canvas></div>
    </article>

    <article class="app-card dashboard-panel grid-span-4">
        <div class="panel-header"><h2>@T["Dashboard.OperationalAlerts"]</h2></div>
        @if (Model.EmManutencao > 0)
        {
            <div class="alert alert-warning mb-0"><i class="bi bi-exclamation-triangle me-1"></i>@Model.EmManutencao @T["Dashboard.Maintenance"].ToLower()</div>
        }
        else
        {
            <div class="alert alert-success mb-0"><i class="bi bi-check-circle me-1"></i>@T["Dashboard.NoAlerts"]</div>
        }
    </article>

    <article class="app-card dashboard-panel grid-span-7">
        <div class="panel-header"><h2>@T["Dashboard.BySector"]</h2></div>
        <div class="chart-box"><canvas id="graficoSetor"></canvas></div>
    </article>

    <article class="app-card dashboard-panel grid-span-5">
        <div class="panel-header"><h2>@T["Dashboard.ByType"]</h2></div>
        <div class="chart-box"><canvas id="graficoTipo"></canvas></div>
    </article>

    <article class="app-card dashboard-panel grid-span-12">
        <div class="panel-header"><h2>@T["Dashboard.ValueSummary"]</h2></div>
        <div class="chart-box compact"><canvas id="graficoValor"></canvas></div>
    </article>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const labelsSetor = @Html.Raw(Json.Serialize(labelsSetor));
        const dataSetor = @Html.Raw(Json.Serialize(dataSetor));
        const idsSetor = @Html.Raw(Json.Serialize(idsSetor));
        const dadosStatus = @Html.Raw(Json.Serialize(Model.AtivosPorStatus));
        const dadosTipo = @Html.Raw(Json.Serialize(Model.AtivosPorTipo));
        const dadosValor = @Html.Raw(Json.Serialize(new[] { Model.ValorTotalInvestido, Model.ValorTotalAtual }));
        const labelsValor = @Html.Raw(Json.Serialize(new[] { T["Common.Invested"], T["Common.Current"] }));

        let chartSetor, chartStatus, chartTipo, chartValor;

        function chartColors() {
            const dark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
            return {
                text: dark ? '#e8eef7' : '#172033',
                grid: dark ? 'rgba(232,238,247,.12)' : 'rgba(23,32,51,.10)',
                blue: dark ? '#6ea8fe' : '#0d6efd',
                green: dark ? '#75b798' : '#198754',
                yellow: dark ? '#ffda6a' : '#ffc107',
                red: dark ? '#ea868f' : '#dc3545'
            };
        }

        function baseOptions() {
            const c = chartColors();
            return {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { labels: { color: c.text } } },
                scales: {
                    x: { ticks: { color: c.text }, grid: { color: c.grid } },
                    y: { beginAtZero: true, ticks: { color: c.text, precision: 0 }, grid: { color: c.grid } }
                }
            };
        }

        function renderCharts() {
            [chartSetor, chartStatus, chartTipo, chartValor].forEach(chart => chart?.destroy());
            const c = chartColors();

            chartSetor = new Chart(document.getElementById('graficoSetor'), {
                type: 'bar',
                data: { labels: labelsSetor, datasets: [{ label: '@T["Common.Total"]', data: dataSetor, backgroundColor: c.blue + '99', borderColor: c.blue, borderWidth: 1 }] },
                options: { ...baseOptions(), onClick: (_, active) => { if (active.length) window.location.href = '/Ativos?setorFilter=' + encodeURIComponent(idsSetor[active[0].index]); } }
            });

            chartStatus = new Chart(document.getElementById('graficoStatus'), {
                type: 'doughnut',
                data: { labels: Object.keys(dadosStatus), datasets: [{ data: Object.values(dadosStatus), backgroundColor: [c.green, c.blue, c.yellow, c.red] }] },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { color: c.text } } } }
            });

            chartTipo = new Chart(document.getElementById('graficoTipo'), {
                type: 'bar',
                data: { labels: Object.keys(dadosTipo), datasets: [{ label: '@T["Common.Total"]', data: Object.values(dadosTipo), backgroundColor: c.green + '99', borderColor: c.green, borderWidth: 1 }] },
                options: baseOptions()
            });

            chartValor = new Chart(document.getElementById('graficoValor'), {
                type: 'bar',
                data: { labels: labelsValor, datasets: [{ label: '@T["Common.PurchaseValue"]', data: dadosValor, backgroundColor: [c.blue + '99', c.green + '99'], borderColor: [c.blue, c.green], borderWidth: 1 }] },
                options: baseOptions()
            });
        }

        renderCharts();
        window.addEventListener('techasset:themechanged', renderCharts);
    </script>
}
