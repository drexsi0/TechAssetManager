@inject IUiTextService T
@{
    ViewData["Title"] = T["Reports.Title"];
}

<section class="dashboard-hero">
    <div>
        <h1 class="dashboard-title">@T["Reports.Title"]</h1>
        <p class="dashboard-subtitle">@T["Reports.Subtitle"]</p>
    </div>
</section>

<div class="dashboard-grid">
    <article class="app-card dashboard-panel grid-span-6">
        <div class="d-flex align-items-start gap-3">
            <span class="kpi-icon text-success"><i class="bi bi-file-earmark-excel fs-4"></i></span>
            <div>
                <h2 class="mb-2">@T["Reports.ExcelTitle"]</h2>
                <p class="text-muted mb-3">@T["Reports.ExcelDescription"]</p>
                <a asp-action="ExportarAtivosExcel" class="btn btn-success">
                    <i class="bi bi-download me-1"></i>@T["Reports.ExcelButton"]
                </a>
            </div>
        </div>
    </article>

    <article class="app-card dashboard-panel grid-span-6">
        <div class="d-flex align-items-start gap-3">
            <span class="kpi-icon text-danger"><i class="bi bi-file-earmark-pdf fs-4"></i></span>
            <div>
                <h2 class="mb-2">@T["Reports.PdfTitle"]</h2>
                <p class="text-muted mb-3">@T["Reports.PdfDescription"]</p>
                <a asp-action="ExportarAtivosPdf" class="btn btn-danger">
                    <i class="bi bi-download me-1"></i>@T["Reports.PdfButton"]
                </a>
            </div>
        </div>
    </article>
</div>
