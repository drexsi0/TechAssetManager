@model IEnumerable<GerenciadorAtivos.Models.ViewModels.UserRoleViewModel>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Usuários";
}

<h1>Usuários</h1>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success">@statusMessage</div>
}

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="thead-azul">
            <tr>
                <th>E-mail</th>
                <th>Perfil atual</th>
                <th>Novo perfil</th>
                <th class="text-end">Ação</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usuario in Model)
            {
                <tr>
                    <td>@usuario.Email</td>
                    <td><span class="badge bg-primary">@usuario.CurrentRole</span></td>
                    <td>
                        <form id="role-form-@usuario.UserId" asp-action="UpdateRole" method="post" class="d-flex gap-2 justify-content-end">
                            <input type="hidden" name="userId" value="@usuario.UserId" />
                            <select name="selectedRole" class="form-select form-select-sm w-auto">
                                @foreach (var role in (IEnumerable<SelectListItem>)ViewBag.Roles)
                                {
                                    <option value="@role.Value" selected="@(role.Value == usuario.SelectedRole)">@role.Text</option>
                                }
                            </select>
                        </form>
                    </td>
                    <td class="text-end">
                        <button type="submit" form="role-form-@usuario.UserId" class="btn btn-sm btn-outline-primary">Salvar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
