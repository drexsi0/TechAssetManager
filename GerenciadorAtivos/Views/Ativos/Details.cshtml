@model GerenciadorAtivos.Models.Ativo
@using GerenciadorAtivos.Services
@inject IUiTextService T
@inject IUserDisplayService UserDisplay

@{
    ViewData["Title"] = T.IsEnglish ? "Asset details" : "Detalhes do ativo";
    var setorTexto = Html.GetEnumSelectList<GerenciadorAtivos.Models.SetorAtivo>()
        .FirstOrDefault(x => x.Value == Model.Setor)?.Text ?? Model.Setor;
}

<section class="dashboard-hero">
    <div>
        <span class="eyebrow">@T["Nav.Inventory"]</span>
        <h1 class="dashboard-title">@Model.Nome</h1>
        <p class="dashboard-subtitle">@T["Common.Patrimony"]: @Model.Patrimonio</p>
    </div>
    <div class="d-flex gap-2">
        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>@(T.IsEnglish ? "Edit" : "Editar")</a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">@(T.IsEnglish ? "Back" : "Voltar")</a>
    </div>
</section>

<div class="dashboard-grid">
    <section class="app-card dashboard-panel grid-span-7">
        <div class="panel-header">
            <h2>@(T.IsEnglish ? "Asset data" : "Dados do ativo")</h2>
        </div>
        <dl class="detail-list">
            <dt>@T["Common.Name"]</dt>
            <dd>@Model.Nome</dd>
            <dt>@T["Common.Patrimony"]</dt>
            <dd><code>@Model.Patrimonio</code></dd>
            <dt>@T["Common.Type"]</dt>
            <dd>@Html.DisplayFor(model => model.Tipo)</dd>
            <dt>@T["Common.BrandModel"]</dt>
            <dd>@Model.Marca / @Model.Modelo</dd>
            <dt>@T["Common.Sector"]</dt>
            <dd>@setorTexto</dd>
            <dt>@T["Common.Status"]</dt>
            <dd>@Html.DisplayFor(model => model.Status)</dd>
            <dt>@T["Common.Responsible"]</dt>
            <dd>
                @if (Model.Responsavel?.Email != null)
                {
                    @await UserDisplay.GetAuditUserDisplayNameAsync(Model.Responsavel.Email)
                }
                else
                {
                    @T["Common.NoResponsible"]
                }
            </dd>
        </dl>
    </section>

    <section class="app-card dashboard-panel grid-span-5">
        <div class="panel-header">
            <h2>@(T.IsEnglish ? "Financial summary" : "Resumo financeiro")</h2>
        </div>
        <div class="metric-row"><span>@T["Common.PurchaseValue"]</span><strong>@Model.ValorCompra.ToString("C")</strong></div>
        <div class="metric-row"><span>@(T.IsEnglish ? "Purchase date" : "Data de compra")</span><strong>@Model.DataCompra.ToShortDateString()</strong></div>
        <div class="metric-row"><span>@T["Common.CurrentValue"]</span><strong class="text-success">@Model.ValorAtual.ToString("C")</strong></div>
        <div class="metric-row"><span>@(T.IsEnglish ? "Depreciation" : "Depreciação")</span><strong class="text-danger">@((Model.ValorCompra - Model.ValorAtual).ToString("C"))</strong></div>
    </section>

    <section class="app-card dashboard-panel grid-span-12">
        <div class="panel-header">
            <h2><i class="bi bi-clock-history me-1"></i>@(T.IsEnglish ? "Movement history" : "Histórico de movimentações")</h2>
        </div>

        @if (Model.Historicos != null && Model.Historicos.Any())
        {
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@(T.IsEnglish ? "Date/time" : "Data/hora")</th>
                            <th>@(T.IsEnglish ? "User" : "Usuário")</th>
                            <th>@(T.IsEnglish ? "Action" : "Ação")</th>
                            <th>@(T.IsEnglish ? "Details" : "Detalhes")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Historicos.OrderByDescending(h => h.DataAcao))
                        {
                            <tr>
                                <td>@item.DataAcao.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@await UserDisplay.GetAuditUserDisplayNameAsync(item.Usuario)</td>
                                <td><span class="badge bg-secondary">@item.TipoAcao</span></td>
                                <td>@item.Descricao</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-light text-center border mb-0">
                <span class="text-muted">@(T.IsEnglish ? "No history has been recorded for this asset yet." : "Nenhum histórico registrado para este ativo ainda.")</span>
            </div>
        }
    </section>
</div>
