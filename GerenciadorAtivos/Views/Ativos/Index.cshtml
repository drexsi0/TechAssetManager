@using X.PagedList
@using X.PagedList.Mvc.Core
@using GerenciadorAtivos.Services
@inject IUiTextService T
@inject IUserDisplayService UserDisplay
@model IPagedList<GerenciadorAtivos.Models.Ativo>

@{
    ViewData["Title"] = T["Nav.Inventory"];

    var statusList = Html.GetEnumSelectList<GerenciadorAtivos.Models.StatusAtivo>();
    var setorList = Html.GetEnumSelectList<GerenciadorAtivos.Models.SetorAtivo>();
    var tipoList = Html.GetEnumSelectList<GerenciadorAtivos.Models.TipoAtivo>();

    if (ViewData["StatusFilter"] != null)
    {
        var val = Convert.ToInt32(ViewData["StatusFilter"]).ToString();
        var selected = statusList.FirstOrDefault(x => x.Value == val);
        if (selected != null) { selected.Selected = true; }
    }
    if (ViewData["SetorFilter"] != null)
    {
        var val = Convert.ToInt32(ViewData["SetorFilter"]).ToString();
        var selected = setorList.FirstOrDefault(x => x.Value == val);
        if (selected != null) { selected.Selected = true; }
    }
    if (ViewData["TipoFilter"] != null)
    {
        var val = Convert.ToInt32(ViewData["TipoFilter"]).ToString();
        var selected = tipoList.FirstOrDefault(x => x.Value == val);
        if (selected != null) { selected.Selected = true; }
    }

    var hasFilters = ViewData["CurrentFilter"] != null || ViewData["StatusFilter"] != null || ViewData["SetorFilter"] != null || ViewData["TipoFilter"] != null;
}

<section class="dashboard-hero">
    <div>
        <span class="eyebrow">@T["Nav.Inventory"]</span>
        <h1 class="dashboard-title">@(T.IsEnglish ? "Asset inventory" : "Inventário de ativos")</h1>
        <p class="dashboard-subtitle">@(T.IsEnglish ? "Search, filter and manage the assets registered in TechAsset." : "Pesquise, filtre e gerencie os ativos cadastrados no TechAsset.")</p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-lg me-1"></i>@(T.IsEnglish ? "New asset" : "Novo ativo")</a>
    }
</section>

<div class="app-card filter-card mb-4">
    <form asp-action="Index" method="get">
        <div class="inventory-toolbar">
            <div class="input-group inventory-search">
                    <input type="text" name="searchString" class="form-control" placeholder="@(T.IsEnglish ? "Name or asset tag..." : "Nome ou patrimônio...")" value="@ViewData["CurrentFilter"]">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i>@(T.IsEnglish ? "Search" : "Buscar")</button>
                    @if (hasFilters)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary" title="@(T.IsEnglish ? "Clear filters" : "Limpar filtros")">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
            </div>

            <div>
                <button class="btn btn-outline-secondary inventory-filter-button" type="button" data-bs-toggle="collapse" data-bs-target="#filtrosAvancados" aria-expanded="false">
                    <i class="bi bi-funnel me-1"></i>@(T.IsEnglish ? "Advanced filters" : "Filtros avançados")
                </button>
            </div>
        </div>

        <div class="collapse @(hasFilters ? "show" : "")" id="filtrosAvancados">
            <div class="filter-panel">
                <div class="advanced-filter-grid">
                    <div>
                        <label class="form-label">@T["Common.Status"]</label>
                        <select name="statusFilter" class="form-select" asp-items="statusList">
                            <option value="">@(T.IsEnglish ? "All" : "Todos")</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label">@T["Common.Sector"]</label>
                        <select name="setorFilter" class="form-select" asp-items="setorList">
                            <option value="">@(T.IsEnglish ? "All" : "Todos")</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label">@T["Common.Type"]</label>
                        <select name="tipoFilter" class="form-select" asp-items="tipoList">
                            <option value="">@(T.IsEnglish ? "All" : "Todos")</option>
                        </select>
                    </div>
                    <div>
                        <button type="submit" class="btn btn-primary">@(T.IsEnglish ? "Apply filters" : "Aplicar filtros")</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<div class="app-card table-card inventory-table-card">
    <div class="table-responsive">
        <table class="table table-hover table-striped align-middle mb-0">
            <thead class="thead-azul">
                <tr>
                    <th>@T["Common.Name"]</th>
                    <th>@T["Common.Patrimony"]</th>
                    <th>@T["Common.Type"]</th>
                    <th>@T["Common.Sector"]</th>
                    <th>@T["Common.Responsible"]</th>
                    <th>@T["Common.Status"]</th>
                    <th>@T["Common.CurrentValue"]</th>
                    <th class="text-end">@(T.IsEnglish ? "Actions" : "Ações")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@Html.DisplayFor(modelItem => item.Nome)</td>
                        <td><code>@Html.DisplayFor(modelItem => item.Patrimonio)</code></td>
                        <td>@Html.DisplayFor(modelItem => item.Tipo)</td>
                        <td>
                            @{
                                var setorTexto = Html.GetEnumSelectList<GerenciadorAtivos.Models.SetorAtivo>()
                                    .FirstOrDefault(x => x.Value == item.Setor)?.Text ?? item.Setor;
                            }
                            @setorTexto
                        </td>
                        <td>
                            @if (item.Responsavel?.Email != null)
                            {
                                @await UserDisplay.GetAuditUserDisplayNameAsync(item.Responsavel.Email)
                            }
                            else
                            {
                                @T["Common.NoResponsible"]
                            }
                        </td>
                        <td>
                            @{
                                string corBadge = "bg-secondary";
                                if (item.Status == GerenciadorAtivos.Models.StatusAtivo.Disponivel) { corBadge = "bg-success"; }
                                else if (item.Status == GerenciadorAtivos.Models.StatusAtivo.EmUso) { corBadge = "bg-primary"; }
                                else if (item.Status == GerenciadorAtivos.Models.StatusAtivo.Manutencao) { corBadge = "bg-warning text-dark"; }
                                else if (item.Status == GerenciadorAtivos.Models.StatusAtivo.Descartado) { corBadge = "bg-danger"; }
                            }
                            <span class="badge @corBadge">@Html.DisplayFor(modelItem => item.Status)</span>
                        </td>
                        <td>
                            <span class="fw-bold text-success">@item.ValorAtual.ToString("C")</span>
                            <br />
                            <small class="text-muted" title="@T["Common.PurchaseValue"]">
                                @(T.IsEnglish ? "Paid" : "Pago"): @item.ValorCompra.ToString("C")
                            </small>
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary">@(T.IsEnglish ? "Edit" : "Editar")</a>
                                }
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info">@(T.IsEnglish ? "View" : "Ver")</a>
                                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                {
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">@(T.IsEnglish ? "Delete" : "Excluir")</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex justify-content-center align-items-center mt-4 gap-3">
    @{
        var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
        var nextDisabled = !Model.HasNextPage ? "disabled" : "";
    }
    <a asp-action="Index"
       asp-route-pageNumber="@(Model.PageNumber - 1)"
       asp-route-searchString="@ViewData["CurrentFilter"]"
       asp-route-statusFilter="@ViewData["StatusFilter"]"
       asp-route-setorFilter="@ViewData["SetorFilter"]"
       asp-route-tipoFilter="@ViewData["TipoFilter"]"
       class="btn btn-outline-primary @prevDisabled">
        &laquo; @(T.IsEnglish ? "Previous" : "Anterior")
    </a>
    <span class="fw-bold text-muted">@(T.IsEnglish ? "Page" : "Página") @Model.PageNumber @(T.IsEnglish ? "of" : "de") @Model.PageCount</span>
    <a asp-action="Index"
       asp-route-pageNumber="@(Model.PageNumber + 1)"
       asp-route-searchString="@ViewData["CurrentFilter"]"
       asp-route-statusFilter="@ViewData["StatusFilter"]"
       asp-route-setorFilter="@ViewData["SetorFilter"]"
       asp-route-tipoFilter="@ViewData["TipoFilter"]"
       class="btn btn-outline-primary @nextDisabled">
        @(T.IsEnglish ? "Next" : "Próximo") &raquo;
    </a>
</div>
