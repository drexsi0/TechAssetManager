@model GerenciadorAtivos.Models.Ativo
@inject IUiTextService T

@{
    ViewData["Title"] = T.IsEnglish ? "Delete asset" : "Excluir ativo";
    var setorTexto = Html.GetEnumSelectList<GerenciadorAtivos.Models.SetorAtivo>()
        .FirstOrDefault(x => x.Value == Model.Setor)?.Text ?? Model.Setor;
}

<section class="dashboard-hero">
    <div>
        <span class="eyebrow">@T["Nav.Inventory"]</span>
        <h1 class="dashboard-title">@ViewData["Title"]</h1>
        <p class="dashboard-subtitle text-danger">@(T.IsEnglish ? "Confirm the logical removal of this asset from the active inventory." : "Confirme a remoção lógica deste ativo do inventário ativo.")</p>
    </div>
</section>

<div class="app-card">
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-1"></i>
        @(T.IsEnglish ? "This asset will no longer appear in active inventory lists." : "Este ativo não aparecerá mais nas listas ativas do inventário.")
    </div>

    <dl class="detail-list">
        <dt>@T["Common.Name"]</dt>
        <dd>@Model.Nome</dd>
        <dt>@T["Common.Patrimony"]</dt>
        <dd><code>@Model.Patrimonio</code></dd>
        <dt>@T["Common.Type"]</dt>
        <dd>@Html.DisplayFor(model => model.Tipo)</dd>
        <dt>@T["Common.Sector"]</dt>
        <dd>@setorTexto</dd>
    </dl>

    <form asp-action="Delete" class="form-actions">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">@(T.IsEnglish ? "Confirm deletion" : "Confirmar exclusão")</button>
        <a asp-action="Index" class="btn btn-outline-secondary">@(T.IsEnglish ? "Cancel" : "Cancelar")</a>
    </form>
</div>
