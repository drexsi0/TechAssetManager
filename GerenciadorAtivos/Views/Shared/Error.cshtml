@model ErrorViewModel
@inject IUiTextService T
@{
    ViewData["Title"] = T["Error.Title"];
}

<section class="app-card dashboard-panel">
    <h1 class="text-danger">@T["Error.Title"]</h1>
    <p class="lead text-danger">@T["Error.Message"]</p>

    @if (Model.ShowRequestId)
    {
        <p><strong>@T["Error.RequestId"]:</strong> <code>@Model.RequestId</code></p>
    }

    <p class="text-muted mb-0">
        @(T.IsEnglish
            ? "If the problem persists, contact the system administrator and provide the request ID above."
            : "Se o problema persistir, contate o administrador do sistema e informe o ID da requisição acima.")
    </p>
</section>
