@page
@model ForgotPasswordConfirmation
@inject IUiTextService T
@{
    ViewData["Title"] = T.IsEnglish ? "Password reset requested" : "Redefinição solicitada";
}

<h1>@ViewData["Title"]</h1>
<p>
    @(T.IsEnglish ? "Please check your email to reset your password." : "Verifique seu e-mail para redefinir a senha.")
</p>
