@page
@model LoginWithRecoveryCodeModel
@inject IUiTextService T
@{
    ViewData["Title"] = T.IsEnglish ? "Recovery code verification" : "Verificação por código de recuperação";
}

<h1>@ViewData["Title"]</h1>
<hr />
<p>
    @(T.IsEnglish
        ? "You requested to log in with a recovery code. This login will not be remembered until you provide an authenticator app code or disable 2FA and log in again."
        : "Você solicitou entrada com código de recuperação. Este login não será lembrado até você informar um código do autenticador ou desativar o 2FA e entrar novamente.")
</p>
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" placeholder="RecoveryCode" />
                <label asp-for="Input.RecoveryCode" class="form-label"></label>
                <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">@(T.IsEnglish ? "Log in" : "Entrar")</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
