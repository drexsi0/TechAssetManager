@page
@model ResetPasswordConfirmationModel
@inject IUiTextService T
@{
    ViewData["Title"] = T.IsEnglish ? "Password reset completed" : "Senha redefinida";
}

<h1>@ViewData["Title"]</h1>
<p>
    @(T.IsEnglish ? "Your password has been reset." : "Sua senha foi redefinida.")
    <a asp-page="./Login">@(T.IsEnglish ? "Click here to log in." : "Clique aqui para entrar.")</a>
</p>
