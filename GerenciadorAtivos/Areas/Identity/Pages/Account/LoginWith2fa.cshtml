@page
@model LoginWith2faModel
@inject IUiTextService T
@{
    ViewData["Title"] = T.IsEnglish ? "Two-factor authentication" : "Autenticação em dois fatores";
}

<h1>@ViewData["Title"]</h1>
<hr />
<p>@(T.IsEnglish ? "Your login is protected with an authenticator app. Enter your authenticator code below." : "Seu login está protegido por aplicativo autenticador. Informe o código abaixo.")</p>
<div class="row">
    <div class="col-md-4">
        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <input asp-for="RememberMe" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.TwoFactorCode" class="form-control" autocomplete="off" />
                <label asp-for="Input.TwoFactorCode" class="form-label"></label>
                <span asp-validation-for="Input.TwoFactorCode" class="text-danger"></span>
            </div>
            <div class="checkbox mb-3">
                <label asp-for="Input.RememberMachine" class="form-label">
                    <input asp-for="Input.RememberMachine" />
                    @Html.DisplayNameFor(m => m.Input.RememberMachine)
                </label>
            </div>
            <div>
                <button type="submit" class="w-100 btn btn-lg btn-primary">@(T.IsEnglish ? "Log in" : "Entrar")</button>
            </div>
        </form>
    </div>
</div>
<p>
    @(T.IsEnglish ? "Don't have access to your authenticator device?" : "Está sem acesso ao autenticador?")
    <a id="recovery-code-login" asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl">@(T.IsEnglish ? "Log in with a recovery code" : "Entrar com código de recuperação")</a>.
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
