@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirme seu E-mail";
}

<div class="text-center mt-5">
    <h1 class="display-4 text-primary">Quase lá!</h1>
    <p class="lead mt-3">
        Nós enviamos um link de confirmação para o seu e-mail.<br />
        Por favor, <strong>verifique sua caixa de entrada (e a pasta de spam)</strong> e clique no link para ativar sua conta.
    </p>
    <a href="/" class="btn btn-outline-primary mt-4">Voltar para o Início</a>
</div>